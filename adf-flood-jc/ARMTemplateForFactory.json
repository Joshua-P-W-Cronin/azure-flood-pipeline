{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-flood-jc"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stfloodpipelinejc.dfs.core.windows.net/"
		},
		"ls_azuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-flood-jc.database.windows.net"
		},
		"ls_azuresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-flood"
		},
		"ls_ea_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://environment.data.gov.uk/flood-monitoring/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_backfill_archive')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "7 day readings backfill\n",
				"activities": [
					{
						"name": "foreach_day",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@range(2,pipeline().parameters.days)",
								"type": "Expression"
							},
							"batchCount": 4,
							"activities": [
								{
									"name": "copy_archive_day",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 58,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "HttpReadSettings",
												"requestMethod": "GET"
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_ea_binary",
											"type": "DatasetReference",
											"parameters": {
												"relativeUrl": {
													"value": "@concat('archive/readings-', addDays(pipeline().TriggerTime, mul(-1, item()), 'yyyy-MM-dd'), '.csv')",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_lake_binary",
											"type": "DatasetReference",
											"parameters": {
												"container": "raw",
												"folderPath": {
													"value": "@concat('readings_archive/date=', addDays(pipeline().TriggerTime, mul(-1, item()), 'yyyy-MM-dd'))",
													"type": "Expression"
												},
												"fileName": {
													"value": "@concat('readings-', addDays(pipeline().TriggerTime, mul(-1, item()), 'yyyy-MM-dd'), '.csv')",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"days": {
						"type": "int",
						"defaultValue": 7
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_ea_binary')]",
				"[concat(variables('factoryId'), '/datasets/ds_lake_binary')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingest_readings')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "copy_readings",
						"description": "copy the latest readings json from environment monitoring. Run every hour",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "BinarySource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							},
							"sink": {
								"type": "BinarySink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_ea_binary",
								"type": "DatasetReference",
								"parameters": {
									"relativeUrl": "data/readings?latest"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_lake_binary",
								"type": "DatasetReference",
								"parameters": {
									"container": "raw",
									"folderPath": {
										"value": "@concat('readings/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'))",
										"type": "Expression"
									},
									"fileName": {
										"value": "@concat('readings_', formatDateTime(pipeline().TriggerTime, 'HHmm'), '.json')",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_ea_binary')]",
				"[concat(variables('factoryId'), '/datasets/ds_lake_binary')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingest_stations')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "copy_stations",
						"description": "Copy activity to get full station history from /id/stations?_view=full to raw/stations/load_date=yyyy-MM-dd/stations.json",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "BinarySource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							},
							"sink": {
								"type": "BinarySink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_ea_binary",
								"type": "DatasetReference",
								"parameters": {
									"relativeUrl": "id/stations?_view=full"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_lake_binary",
								"type": "DatasetReference",
								"parameters": {
									"container": "raw",
									"folderPath": {
										"value": "@concat('stations/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'))",
										"type": "Expression"
									},
									"fileName": "stations.json"
								}
							}
						]
					},
					{
						"name": "copy_measures",
						"description": "Copy activity to get full measure history from /id/stations?_view=full to raw/stations/load_date=yyyy-MM-dd/stations.json",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "BinarySource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							},
							"sink": {
								"type": "BinarySink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_ea_binary",
								"type": "DatasetReference",
								"parameters": {
									"relativeUrl": "id/measures"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_lake_binary",
								"type": "DatasetReference",
								"parameters": {
									"container": "raw",
									"folderPath": {
										"value": "@concat('measures/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'))",
										"type": "Expression"
									},
									"fileName": "measures.json"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_ea_binary')]",
				"[concat(variables('factoryId'), '/datasets/ds_lake_binary')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_load_sql')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "set_load_date",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_date",
							"value": {
								"value": "@if(empty(pipeline().parameters.load_date), formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), pipeline().parameters.load_date)",
								"type": "Expression"
							}
						}
					},
					{
						"name": "copy_stg_stations",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "set_load_date",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"additionalColumns": [
									{
										"name": "source_file",
										"value": "$$FILEPATH"
									}
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "AzureSqlSink",
								"preCopyScript": "TRUNCATE TABLE stg.stations",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"path": "[['@id']"
										},
										"sink": {
											"name": "station_uri",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['catchmentName']"
										},
										"sink": {
											"name": "catchment_name",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['easting']"
										},
										"sink": {
											"name": "easting",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['label']"
										},
										"sink": {
											"name": "label",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['lat']"
										},
										"sink": {
											"name": "latitude",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['long']"
										},
										"sink": {
											"name": "longitude",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['northing']"
										},
										"sink": {
											"name": "northing",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['riverName']"
										},
										"sink": {
											"name": "river_name",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['stageScale']['typicalRangeHigh']"
										},
										"sink": {
											"name": "typical_range_high",
											"type": "Double"
										}
									},
									{
										"source": {
											"path": "[['stageScale']['typicalRangeLow']"
										},
										"sink": {
											"name": "typical_range_low",
											"type": "Double"
										}
									},
									{
										"source": {
											"path": "[['stationReference']"
										},
										"sink": {
											"name": "station_reference",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['status']"
										},
										"sink": {
											"name": "status",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['town']"
										},
										"sink": {
											"name": "town",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['source_file']"
										},
										"sink": {
											"name": "source_file",
											"type": "String"
										}
									}
								],
								"collectionReference": "$['items']"
							}
						},
						"inputs": [
							{
								"referenceName": "ds_lake_json",
								"type": "DatasetReference",
								"parameters": {
									"container": "raw",
									"fileName": "stations.json",
									"folderPath": "@concat('stations/load_date=', variables('v_date'))"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_sql_table",
								"type": "DatasetReference",
								"parameters": {
									"schemaName": "stg",
									"tableName": "stations"
								}
							}
						]
					},
					{
						"name": "copy_stg_measures",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "set_load_date",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"additionalColumns": [
									{
										"name": "source_file",
										"value": "$$FILEPATH"
									}
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "AzureSqlSink",
								"preCopyScript": "TRUNCATE TABLE stg.measures",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"path": "[['@id']"
										},
										"sink": {
											"name": "measure_uri",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['label']"
										},
										"sink": {
											"name": "label",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['parameter']"
										},
										"sink": {
											"name": "parameter",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['parameterName']"
										},
										"sink": {
											"name": "parameter_name",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['period']"
										},
										"sink": {
											"name": "period_seconds",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['qualifier']"
										},
										"sink": {
											"name": "qualifier",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['stationReference']"
										},
										"sink": {
											"name": "station_reference",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['unitName']"
										},
										"sink": {
											"name": "unit_name",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['valueType']"
										},
										"sink": {
											"name": "value_type",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['source_file']"
										},
										"sink": {
											"name": "source_file",
											"type": "String"
										}
									}
								],
								"collectionReference": "$['items']"
							}
						},
						"inputs": [
							{
								"referenceName": "ds_lake_json",
								"type": "DatasetReference",
								"parameters": {
									"container": "raw",
									"fileName": "measures.json",
									"folderPath": {
										"value": "@concat('measures/load_date=', variables('v_date'))",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_sql_table",
								"type": "DatasetReference",
								"parameters": {
									"schemaName": "stg",
									"tableName": "measures"
								}
							}
						]
					},
					{
						"name": "copy_stg_readings_hourly",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "set_load_date",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"additionalColumns": [
									{
										"name": "source_file",
										"value": "$$FILEPATH"
									}
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"wildcardFolderPath": {
										"value": "@concat('readings/load_date=', variables('v_date'))",
										"type": "Expression"
									},
									"wildcardFileName": "*.json",
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "AzureSqlSink",
								"preCopyScript": "TRUNCATE TABLE stg.readings",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"path": "[['dateTime']"
										},
										"sink": {
											"name": "date_time",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['measure']"
										},
										"sink": {
											"name": "measure",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['value']"
										},
										"sink": {
											"name": "value",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['source_file']"
										},
										"sink": {
											"name": "source_file",
											"type": "String"
										}
									}
								],
								"collectionReference": "$['items']"
							}
						},
						"inputs": [
							{
								"referenceName": "ds_lake_json",
								"type": "DatasetReference",
								"parameters": {
									"container": "raw",
									"fileName": "*.json",
									"folderPath": "@concat('readings/load_date=', variables('v_date'))"
								}
							}
						],
