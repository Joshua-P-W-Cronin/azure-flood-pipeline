{
	"name": "pl_ingest_stations",
	"properties": {
		"activities": [
			{
				"name": "copy_stations",
				"description": "Copy activity to get full station history from /id/stations?_view=full to raw/stations/load_date=yyyy-MM-dd/stations.json",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_ea_binary",
						"type": "DatasetReference",
						"parameters": {
							"relativeUrl": "id/stations?_view=full"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_lake_binary",
						"type": "DatasetReference",
						"parameters": {
							"container": "raw",
							"folderPath": {
								"value": "@concat('stations/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'))",
								"type": "Expression"
							},
							"fileName": "stations.json"
						}
					}
				]
			},
			{
				"name": "copy_measures",
				"description": "Copy activity to get full measure history from /id/stations?_view=full to raw/stations/load_date=yyyy-MM-dd/stations.json",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_ea_binary",
						"type": "DatasetReference",
						"parameters": {
							"relativeUrl": "id/measures"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_lake_binary",
						"type": "DatasetReference",
						"parameters": {
							"container": "raw",
							"folderPath": {
								"value": "@concat('measures/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'))",
								"type": "Expression"
							},
							"fileName": "measures.json"
						}
					}
				]
			}
		],
		"annotations": []
	}
}